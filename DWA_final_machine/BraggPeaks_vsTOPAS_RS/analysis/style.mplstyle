figure.dpi: 100
figure.facecolor: white
figure.constrained_layout.use: True
font.size: 8
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
axes.linewidth: 0.5
axes.labelsize: 9
axes.titlesize: 9
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
axes.grid: False
xtick.major.size: 3
xtick.major.width: 0.5
xtick.labelsize: 7
xtick.direction: out
ytick.major.size: 3
ytick.major.width: 0.5
ytick.labelsize: 7
ytick.direction: out
lines.linewidth: 1.5
legend.fontsize: 7
legend.frameon: False
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.facecolor: white
